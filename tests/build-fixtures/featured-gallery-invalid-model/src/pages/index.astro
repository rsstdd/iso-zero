---
import heroSource from "../../../../../src/assets/venice/_DSF0140.JPG";
// biome-ignore lint/correctness/noUnusedImports: Astro resolves the component in the template.
import FeaturedGallery from "../../../../../src/components/FeaturedGallery.astro";

const testCase = process.env.FEATURED_GALLERY_INVALID_CASE ?? "valid";
const forgedSource = { ...heroSource };
const gallery = {
	slug: "venice",
	title: "Venice",
	location: "Venice, Italy",
	publicationDate: new Date("2026-08-01T00:00:00.000Z"),
	imageCount: 12,
	hero: {
		id: "venice-arcade",
		src: forgedSource,
		alt: "Receding stone arches and hanging lanterns along an arcade in Venice.",
		width: 2048,
		height: 1155,
	},
};

switch (testCase) {
	case "blank-slug":
		gallery.slug = "   ";
		break;
	case "blank-title":
		gallery.title = "   ";
		break;
	case "blank-location":
		gallery.location = "   ";
		break;
	case "invalid-date":
		gallery.publicationDate = new Date(Number.NaN);
		break;
	case "zero-count":
		gallery.imageCount = 0;
		break;
	case "blank-hero-id":
		gallery.hero.id = "   ";
		break;
	case "blank-alt":
		gallery.hero.alt = "   ";
		break;
	case "unknown-dimensions":
		gallery.hero.width = 0;
		gallery.hero.height = 0;
		break;
	case "dimension-mismatch":
		gallery.hero.width = 2047;
		break;
	case "source-ceiling":
		Object.assign(forgedSource, { width: 4096, height: 2310 });
		gallery.hero.width = 4096;
		gallery.hero.height = 2310;
		break;
	case "delivery-policy":
		Object.assign(forgedSource, { format: "png" });
		break;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Featured Gallery invalid-model fixture</title>
  </head>
  <body>
    <main>
      <FeaturedGallery gallery={gallery} />
    </main>
  </body>
</html>
