---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  formatFeaturedGalleryImageCount,
  formatFeaturedGalleryPublicationDate,
} from "../lib/featured-gallery-formatters";
import DataPlate from "./DataPlate.astro";

interface FeaturedGalleryModel {
  readonly slug: string;
  readonly title: string;
  readonly location: string;
  readonly publicationDate: Date;
  readonly imageCount: number;
  readonly hero: {
    readonly id: string;
    readonly src: ImageMetadata;
    readonly alt: string;
    readonly width: number;
    readonly height: number;
  };
}

interface Props {
  readonly gallery: FeaturedGalleryModel;
}

const { gallery }: Props = Astro.props;

const MAX_SOURCE_DIMENSION = 2048;
const CANDIDATE_WIDTHS = [640, 960, 1280, 1600, 2048] as const;
const RESPONSIVE_SIZES =
  "min(calc(100vw - clamp(1.25rem, 4vw, 2.5rem) - clamp(1.25rem, 4vw, 2.5rem)), 87.5rem, 127.6052svh)";

function requireNonBlank(value: string, field: string): string {
  if (typeof value !== "string" || value.trim().length === 0) {
    throw new TypeError(`Featured gallery ${field} must be non-blank.`);
  }

  return value.trim();
}

function requirePositiveDimension(value: number, field: string): number {
  if (!Number.isInteger(value) || value < 1) {
    throw new RangeError(
      `Featured gallery ${field} must be a positive integer.`,
    );
  }

  return value;
}

const slug = requireNonBlank(gallery.slug, "slug");
if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
  throw new TypeError(
    "Featured gallery slug must be a canonical lowercase slug.",
  );
}

const title = requireNonBlank(gallery.title, "title");
const location = requireNonBlank(gallery.location, "location");
requireNonBlank(gallery.hero.id, "hero.id");
const alt = requireNonBlank(gallery.hero.alt, "hero.alt");
const width = requirePositiveDimension(gallery.hero.width, "hero.width");
const height = requirePositiveDimension(gallery.hero.height, "hero.height");
const sourceWidth = requirePositiveDimension(
  gallery.hero.src.width,
  "hero.src.width",
);
const sourceHeight = requirePositiveDimension(
  gallery.hero.src.height,
  "hero.src.height",
);

if (width !== sourceWidth || height !== sourceHeight) {
  throw new RangeError(
    "Featured gallery dimensions must match the imported image metadata.",
  );
}

if (sourceWidth > MAX_SOURCE_DIMENSION || sourceHeight > MAX_SOURCE_DIMENSION) {
  throw new RangeError(
    "Featured gallery source exceeds the delivery-policy ceiling.",
  );
}

if (!new Set(["jpg", "jpeg"]).has(gallery.hero.src.format.toLowerCase())) {
  throw new TypeError(
    "Featured gallery source must be a JPEG delivery derivative.",
  );
}

const publication = formatFeaturedGalleryPublicationDate(
  gallery.publicationDate,
);
const publicationDateTime = `${gallery.publicationDate.getUTCFullYear()}-${String(
  gallery.publicationDate.getUTCMonth() + 1,
).padStart(2, "0")}`;
const imageCount = formatFeaturedGalleryImageCount(gallery.imageCount);
const widths = CANDIDATE_WIDTHS.filter((candidate) => candidate <= sourceWidth);
const href = `/galleries/${slug}/`;
---

<a
  class="featured-gallery container-wide"
  href={href}
  aria-labelledby="featured-action featured-title"
  aria-describedby="featured-image-description featured-meta"
>
  <figure>
    <Picture
      src={gallery.hero.src}
      widths={widths}
      formats={["avif", "webp"]}
      fallbackFormat="jpeg"
      sizes={RESPONSIVE_SIZES}
      width={width}
      height={height}
      alt={alt}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <DataPlate
      as="figcaption"
      class="featured-gallery__plate"
      id={`REC // ${gallery.hero.id.toUpperCase()}`}
      status="ACTIVE ARCHIVE"
      title={title}
      specs={[
        { label: "LOCATION", value: location },
        { label: "PUBLICATION", value: publication },
        { label: "INDEX", value: imageCount },
      ]}
    >
      <span id="featured-image-description" class="visually-hidden">
        {alt}
      </span>
      <time datetime={publicationDateTime} class="visually-hidden">
        {publication}
      </time>
      <div class="plate-footer">
        <span id="featured-action" class="standalone">
          View the full catalog
        </span>
      </div>
    </DataPlate>
  </figure>
</a>

<style is:global>
  @layer reset, base, components, utilities;

  @layer components {
    .featured-gallery {
      display: block;
      min-inline-size: 0;
      color: var(--text);
      text-decoration: none;
    }

    .featured-gallery:visited,
    .featured-gallery:hover {
      color: var(--text);
      text-decoration: none;
    }

    .featured-gallery > figure {
      min-inline-size: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      margin: 0;
    }

    .featured-gallery > figure > picture {
      display: flex;
      inline-size: 100%;
      min-inline-size: 0;
      justify-content: center;
      background: var(--bg);
    }

    .featured-gallery > figure > picture > img {
      inline-size: auto;
      block-size: auto;
      max-inline-size: 100%;
      max-block-size: 72vh;
      max-block-size: 72svh;
      border-radius: 0;
      object-fit: contain;
      filter: none;
      box-shadow: none;
      clip-path: none;
    }

    .featured-gallery__plate {
      margin-top: var(--space-3);
    }

    .plate-footer {
      padding-top: var(--space-2);
      border-top: 1px solid var(--border-c);
    }

    .featured-gallery__plate #featured-action:hover {
      text-decoration: underline;
    }
  }
</style>
