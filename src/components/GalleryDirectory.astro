---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import RuleDatum from "./RuleDatum.astro";

interface GallerySummary {
  readonly slug: string;
  readonly title: string;
  readonly publicationDate: Date;
  readonly location?: string;
  readonly imageCount: number;
  readonly coverSrc: ImageMetadata;
  readonly coverAlt?: string;
}

interface Props {
  readonly galleries: readonly GallerySummary[];
  readonly heading?: string;
  readonly headingId?: string;
}

const CANDIDATE_WIDTHS = [480, 640, 960, 1280] as const;

// Matches the responsive 1/2/3-column gallery grid.
const CARD_SIZES = "(min-width: 1200px) 450px, (min-width: 640px) 50vw, 100vw";

const {
  galleries,
  heading = "Available galleries",
  headingId = "gallery-directory-title",
}: Props = Astro.props;

if (galleries.length === 0) {
  throw new TypeError("GalleryDirectory requires at least one gallery.");
}

const slugs = new Set<string>();

const entries = galleries.map((gallery) => {
  const slug = gallery.slug.trim();
  const title = gallery.title.trim();

  if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
    throw new TypeError(`Invalid gallery slug: ${gallery.slug}`);
  }

  if (!title) {
    throw new TypeError("GalleryDirectory requires non-blank titles.");
  }

  if (slugs.has(slug)) {
    throw new TypeError(`Duplicate gallery slug: ${slug}`);
  }

  slugs.add(slug);

  if (
    !(gallery.publicationDate instanceof Date) ||
    Number.isNaN(gallery.publicationDate.valueOf())
  ) {
    throw new TypeError("GalleryDirectory requires valid publication dates.");
  }

  if (!Number.isInteger(gallery.imageCount) || gallery.imageCount < 1) {
    throw new TypeError(
      "GalleryDirectory image counts must be positive integers.",
    );
  }

  const widths = CANDIDATE_WIDTHS.filter(
    (width) => width <= gallery.coverSrc.width,
  );

  return {
    href: `/galleries/${slug}/`,
    title,
    year: String(gallery.publicationDate.getUTCFullYear()),
    count: `${gallery.imageCount} ${
      gallery.imageCount === 1 ? "photograph" : "photographs"
    }`,
    location: gallery.location?.trim() || undefined,
    coverSrc: gallery.coverSrc,
    coverAlt: gallery.coverAlt?.trim() ?? "",
    widths: widths.length ? widths : undefined,
  };
});

const OVERLINE_HEADING = "VISUAL ARCHIVE";
---

<RuleDatum
  as="section"
  labelledBy={headingId}
  class="gallery-directory-section container-wide"
>
  <p class="mono overline underline uppercase text-muted">{OVERLINE_HEADING}</p>
  <h2 id={headingId} class="h2 mt-0">{heading}</h2>
  <div class="gallery-grid">
    {
      entries.map((gallery) => (
        <article class="gallery-card">
          <a href={gallery.href} class="gallery-card-link">
            <div class="gallery-card-image">
              <Picture
                src={gallery.coverSrc}
                alt={gallery.coverAlt}
                widths={gallery.widths}
                sizes={CARD_SIZES}
              />
            </div>
            <div class="gallery-card-content">
              <h3>{gallery.title}</h3>
              <div class="gallery-card-meta">
                {gallery.location && <span>{gallery.location}</span>}
                <span>{gallery.year}</span>
                <span>{gallery.count}</span>
              </div>
            </div>
          </a>
        </article>
      ))
    }
  </div>
</RuleDatum>

<style is:global>
  @layer reset, base, components, utilities;

  @layer components {
    .gallery-directory-section {
      margin-block-start: 4rem;
    }

    .gallery-directory-section > h2 {
      color: var(--text);
      font-family: var(--font-display);
      font-size: var(--text-h2);
      font-weight: 400;
      line-height: var(--text-h2--line-height);
      margin-block-end: 1.5rem;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
      gap: 1.5rem 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .gallery-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      color: var(--text);
      text-decoration: none;
      group: gallery-card;
    }

    .gallery-card-image {
      aspect-ratio: 3 / 2;
      overflow: hidden;
    }

    .gallery-card-image :global(img) {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      /* object-position: center; */
    }

    .gallery-card__media {
      aspect-ratio: 3 / 2;
      overflow: hidden;
      background-color: var(--border-c);
      border: 1px solid var(--border-c);
    }

    .gallery-card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .gallery-card__content {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    /*
     * Per 04_DESIGN_SYSTEM.md's compound-link rule: the outer anchor's
     * decoration is removed only because this title keeps a *persistent*
     * underline. A hover-only underline is exactly the affordance the rule
     * forbids, so the underline is visible by default and only strengthens
     * (1px to 2px) on hover, matching the site-wide link-hover pattern.
     */
    .gallery-card h3 {
      color: var(--text);
      font-family: var(--font-display);
      font-size: var(--text-h3);
      font-weight: 400;
      line-height: var(--text-h3--line-height);
      text-decoration-line: underline;
      text-decoration-color: var(--text);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
      transition: text-decoration-thickness var(--duration-base)
        var(--ease-standard);
    }

    .gallery-card:hover h3 {
      text-decoration-thickness: 2px;
    }

    .gallery-card__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      /* Typographical styles handled globally by Datum's .data-plate class */
    }

    @media (forced-colors: active) {
      .gallery-card__media {
        border-color: CanvasText;
      }
    }
  }
</style>
