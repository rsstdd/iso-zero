---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import RuleDatum from "./RuleDatum.astro";

interface GallerySummary {
  readonly slug: string;
  readonly title: string;
  readonly publicationDate: Date;
  readonly imageCount: number;
  readonly coverSrc: ImageMetadata;
  readonly coverAlt: string;
}

interface Props {
  readonly galleries: readonly GallerySummary[];
  readonly heading?: "Available galleries";
  readonly headingId?: "gallery-directory-title";
}

const {
  galleries,
  heading = "Available galleries",
  headingId = "gallery-directory-title",
}: Props = Astro.props;

if (!Array.isArray(galleries) || galleries.length === 0) {
  throw new TypeError("GalleryDirectory requires at least one gallery.");
}

const slugs = new Set<string>();
const rows = galleries.map((gallery) => {
  const slug = gallery.slug.trim();
  const title = gallery.title.trim();

  if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug) || title.length === 0) {
    throw new TypeError(
      "GalleryDirectory requires canonical slugs and non-blank titles.",
    );
  }

  if (slugs.has(slug)) throw new TypeError(`Duplicate gallery slug: ${slug}`);
  slugs.add(slug);

  if (
    !(gallery.publicationDate instanceof Date) ||
    Number.isNaN(gallery.publicationDate.valueOf())
  ) {
    throw new TypeError("GalleryDirectory requires valid publication dates.");
  }

  if (!Number.isInteger(gallery.imageCount) || gallery.imageCount < 1) {
    throw new TypeError(
      "GalleryDirectory image counts must be positive integers.",
    );
  }

  // if (!gallery.coverSrc || typeof gallery.coverSrc !== "string") {
  //   throw new TypeError(
  //     "GalleryDirectory requires a valid cover image source.",
  //   );
  // }

  return {
    href: `/galleries/${slug}/`,
    title,
    year: String(gallery.publicationDate.getUTCFullYear()),
    count: `${gallery.imageCount} ${gallery.imageCount === 1 ? "image" : "images"}`,
    coverSrc: gallery.coverSrc,
    coverAlt: gallery.coverAlt || `Cover image for ${title} gallery`,
  };
});
---

<RuleDatum
  as="section"
  labelledBy={headingId}
  class="gallery-directory-section container-wide"
>
  <h2 id={headingId}>{heading}</h2>
  <ul class="gallery-grid">
    {
      rows.map((row) => (
        <li class="gallery-grid__item">
          <a href={row.href} class="gallery-card">
            <div class="gallery-card__media">
              <Image
                src={row.coverSrc}
                alt={row.coverAlt}
                width={600}
                height={400}
                format="webp"
              />
            </div>
            <div class="gallery-card__content">
              <h3>{row.title}</h3>
              <span class="gallery-card__meta">
                <time datetime={row.year}>{row.year}</time>
                <span>{row.count}</span>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</RuleDatum>

<style is:global>
  @layer reset, base, components, utilities;

  @layer components {
    .gallery-directory-section {
      margin-block-start: var(--space-section);
    }

    .gallery-directory-section > h2 {
      color: var(--text);
      font-family: var(--font-display);
      font-size: var(--text-h2);
      font-weight: 400;
      line-height: var(--leading-h2);
      margin-block-end: var(--space-6);
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
      gap: var(--space-6) var(--space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .gallery-card {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      color: var(--text);
      text-decoration: none;
      group: gallery-card; /* For hover delegation if supported, otherwise standard child targeting */
    }

    .gallery-card__media {
      aspect-ratio: 3 / 2;
      overflow: hidden;
      background-color: var(--border-c); /* Placeholder color while loading */
      border: 1px solid var(--border-c);
    }

    .gallery-card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease-out;
    }

    .gallery-card:hover .gallery-card__media img {
      transform: scale(1.03);
    }

    .gallery-card__content {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    .gallery-card h3 {
      color: var(--text);
      font-family: var(--font-display);
      font-size: var(--text-h3);
      font-weight: 400;
      line-height: var(--leading-h3);
      text-decoration-line: underline;
      text-decoration-color: transparent;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
      transition: text-decoration-color 0.2s ease;
    }

    .gallery-card:hover h3 {
      text-decoration-color: var(--text);
    }

    .gallery-card__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      color: var(--text-muted);
      font-family: var(--font-data);
      font-feature-settings: "zero";
      font-size: var(--text-data);
      font-variant-numeric: tabular-nums;
    }

    /* Focus states */
    .gallery-card:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 4px;
      border-radius: 2px;
    }

    @media (forced-colors: active) {
      .gallery-card__media {
        border-color: CanvasText;
      }
    }
  }
</style>
