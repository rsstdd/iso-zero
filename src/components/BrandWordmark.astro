---
interface Props {
  readonly label: string;
  readonly variant?: "compact" | "display";
}

const { label, variant = "compact" } = Astro.props;
---

<span
  class:list={["brand-wordmark", `brand-wordmark--${variant}`]}
  data-brand-wordmark={variant}
  aria-label={label}
>
  <span
    class="brand-wordmark__line brand-wordmark__line--iso"
    aria-hidden="true"
  >
    <span>I</span><span>S</span><span>0</span>
  </span>
  <span
    class="brand-wordmark__line brand-wordmark__line--zero"
    aria-hidden="true"
  >
    <span>Z</span><span>E</span><span>R</span><span>0</span>
  </span>
</span>

<style>
  @layer components {
    .brand-wordmark {
      display: inline-grid;
      grid-template-columns: minmax(0, var(--wordmark-width));
      inline-size: var(--wordmark-width);
      max-inline-size: 100%;
      min-inline-size: 0;
      color: inherit;
      background: transparent;
      font-family: var(--font-mono);
      font-size: var(--text-wordmark);
      font-kerning: normal;
      font-synthesis: none;
      font-stretch: condensed;
      line-height: 1;
      row-gap: var(--wordmark-gap);
      text-rendering: geometricPrecision;
      text-transform: uppercase;
      vertical-align: middle;
      font-feature-settings: "zero";
      font-variant-numeric: tabular-nums;
    }

    .brand-wordmark__line {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      inline-size: 100%;
      min-inline-size: 0;
      letter-spacing: var(--tracking-overline);
      line-height: 0.78;
      white-space: nowrap;
    }

    .brand-wordmark__line > span {
      display: block;
      flex: 0 0 auto;
    }

    .brand-wordmark__line--iso {
      font-weight: 600;
    }

    .brand-wordmark__line--zero {
      font-weight: 200;
    }

    .brand-wordmark--compact {
      --wordmark-width: var(--wordmark-compact-width);
      --wordmark-gap: var(--wordmark-compact-gap);
    }

    .brand-wordmark--display {
      --wordmark-width: var(--wordmark-display-width);
      --wordmark-gap: var(--wordmark-display-gap);
    }

    @media (forced-colors: active) {
      .brand-wordmark {
        color: CanvasText;
        forced-color-adjust: auto;
      }
    }
  }
</style>
