---
import BrandWordmark from "./BrandWordmark.astro";

interface Props {
  readonly title: string;
  readonly byline: string;
  readonly headingId?: string;
}

const { title, byline, headingId = "page-title" } = Astro.props;
---

<section class="homepage-identity container-wide" aria-labelledby={headingId}>
  <h1 id={headingId} class="h1 mt-0">
    <BrandWordmark label={title} variant="compact" />
  </h1>
  <p class="font-mono mono text-overline overline uppercase text-muted">
    {byline}
  </p>
</section>

<style is:global>
  @layer reset, base, components, utilities;

  @layer components {
    .homepage-identity {
      min-inline-size: 0;
      padding-block: var(--space-8) var(--space-10);
      color: var(--text);
      background: transparent;
    }

    .homepage-identity h1,
    .homepage-identity p {
      min-inline-size: 0;
      overflow-wrap: normal;
    }

    .homepage-identity h1 {
      color: var(--text);
      font-family: var(--font-data);
      font-size: var(--text-display-xl);
      font-weight: 400;
      line-height: var(--text-display-xl--line-height);
    }

    .homepage-identity p {
      margin-block-start: 0.5rem;
      color: var(--text-muted);
      font: 600 0.8125rem / 1.2 var(--font-mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
  }
</style>
