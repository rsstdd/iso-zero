---
import BrandWordmark from "./BrandWordmark.astro";
import { getHeaderCurrentState } from "../lib/nav/header-current-path";

interface Props {
  readonly currentPath: string;
}

const current = getHeaderCurrentState(Astro.props.currentPath);
const isHomepage = current.wordmark === "page";
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand-group">
      <BrandWordmark
        label="IS0 ZER0 — Photography by Ross Todd"
        variant="compact"
      />
      <div class="site-header__byline-block" aria-hidden="true">
        <span class="byline-line">Photography</span>
        <span class="byline-line">By Ross</span>
      </div>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        <li>
          <a href="/galleries/" aria-current={current.galleries}>Galleries</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style is:global>
  @layer reset, base, components, utilities;

  @layer components {
    .site-header {
      position: static;
      inline-size: min(
        calc(100% - (2 * var(--page-gutter))),
        var(--container-wide)
      );
      min-inline-size: 0;
      margin-inline: auto;
      padding-block: var(--space-3);
      overflow: visible;
      border-block-end: 1px solid var(--border-c);
      border-radius: 0;
      color: var(--text);
      background: transparent;
      box-shadow: none;
    }

    .site-header__inner {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-6);
      inline-size: 100%;
      min-inline-size: 0;
    }

    /* Tightened uniform grid lock using a compact ch width */
    .site-header__brand-group {
      display: flex;
      flex-direction: column;
      inline-size: 7ch;
      min-inline-size: 0;
      gap: 0.15em;
      text-decoration: none;
      color: inherit;
    }

    /* Robust anchor reset for the brand group wrapper */
    .site-header__brand-group,
    .site-header__brand-group:any-link,
    .site-header__brand-group:visited,
    .site-header__brand-group:hover,
    .site-header__brand-group:active {
      display: flex;
      flex-direction: column;
      inline-size: 7ch;
      min-inline-size: 0;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      text-decoration: none !important;
      outline: none;
    }

    /* Force the wordmark component to inherit the compact boundary */
    .site-header__brand-group .brand-wordmark {
      --wordmark-width: 7ch !important;
    }

    .site-header__byline-block {
      color: var(--text-muted);
      display: flex;
      flex-direction: column;
      font-family: var(--font-mono);
      font-feature-settings: "zero";
      font-size: 0.58rem;
      font-variant-numeric: tabular-nums;
      font-weight: 400;
      gap: 0.09em;
      letter-spacing: var(--tracking-overline);
      line-height: 1.1;
      margin: 0.3rem 0 0 0;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .site-header__byline-block .byline-line {
      margin: 0;
      padding: 0;
      font-family: inherit;
      font-size: inherit;
      font-weight: inherit;
      line-height: inherit;
      letter-spacing: var(--wordmark-compact-gap);
      text-transform: inherit;
      color: inherit;
      white-space: nowrap;
    }

    .site-header nav,
    .site-header ul,
    .site-header li {
      min-inline-size: 0;
      max-inline-size: 100%;
    }

    .site-header nav,
    .site-header li {
      display: flex;
    }

    .site-header ul {
      display: flex;
      flex-wrap: wrap;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .site-header nav a {
      display: inline-flex;
      align-items: center;
      min-inline-size: var(--target-min);
      min-block-size: var(--target-min);
      max-inline-size: 100%;
      padding-block: var(--space-2);
      padding-inline: var(--space-2);
      border-radius: 0;
      color: var(--text);
      font-family: var(--font-interface);
      font-size: var(--text-interface);
      line-height: var(--leading-interface);
      overflow-wrap: anywhere;
      text-decoration-line: underline;
      text-decoration-color: currentColor;
      text-decoration-style: solid;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
      text-transform: none;
      white-space: normal;
    }

    .site-header .site-wordmark {
      font-family: var(--font-mono);
      font-size: var(--text-wordmark);
      line-height: var(--leading-display);
    }

    .site-header .site-wordmark .brand-wordmark {
      text-decoration: none;
    }

    .site-header nav a:hover,
    .site-header nav a[aria-current] {
      text-decoration-thickness: 2px;
    }

    @media (forced-colors: active) {
      .site-header {
        border-block-end-color: CanvasText;
      }
    }
  }
</style>
